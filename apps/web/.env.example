# apps/web — local dev environment
#
# Next.js loads this file when it sits next to the app as `.env`.
# Every variable below already has a default in code, so localhost works
# without copying this file. Copy it when you need to point at another API
# or replace the session secret:
#
#   cp apps/web/.env.example apps/web/.env

# Base URL of apps/api. No trailing path.
IRIS_API_BASE_URL=http://localhost:8080

# iron-session password. Must be at least 32 characters.
# The value below is for localhost only.
IRIS_SESSION_PASSWORD=dev-only-do-not-use-in-prod-32+chars-iris-gate-secret

# Cookie name. httpOnly, sameSite=lax; secure only when NODE_ENV=production.
IRIS_SESSION_COOKIE=iris_session

# Absolute origin used for canonical and Open Graph links.
IRIS_SITE_URL=http://localhost:3000
