# Ignore rules for Dockerfile.dev only (BuildKit reads <Dockerfile>.dockerignore).
# The build context is the repo root, so these paths are relative to it.
# Avoid sending heavy host directories; keep workspace manifests and source.

**/node_modules
**/dist
**/build
**/.next
**/.turbo
**/coverage
**/*.log
**/.DS_Store

# yarn cache + install state — installer recreates them inside the image
.yarn/cache
.yarn/install-state.gz
.yarn/unplugged
.yarn/build-state.yml

# generated artifacts
apps/api/bin
apps/web/next-env.d.ts
**/*.tsbuildinfo

# editor / VCS
.git
.idea
.vscode

# host env files — container gets env via compose
**/.env
**/.env.local
**/.env.*.local
