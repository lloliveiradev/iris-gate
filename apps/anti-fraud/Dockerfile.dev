# syntax=docker/dockerfile:1.7
#
# Dev image — runs nest start --watch with source mounted as volume.
# Build context must be the repo root so yarn workspaces resolve correctly.
# The ignore rules for that context live in Dockerfile.dev.dockerignore, next to this file.
# There is no production image yet.

FROM node:26.13.0-alpine

# bash runs the dev and start scripts. Prisma 7 has no query engine binary, so no OpenSSL is needed.
RUN apk add --no-cache bash

# Node 25+ no longer bundles corepack; install it, then let it provide the Yarn
# version pinned in the root package.json (packageManager).
RUN npm install -g corepack@0.34.0 && corepack enable

WORKDIR /repo

# --- Layer 1: workspace manifests + lockfile (Yarn 4 needs ALL workspaces to validate lockfile) ---
COPY package.json yarn.lock .yarnrc.yml ./
COPY apps/anti-fraud/package.json apps/anti-fraud/package.json
COPY apps/web/package.json apps/web/package.json
COPY libs/fraud/package.json libs/fraud/package.json
COPY libs/contracts/package.json libs/contracts/package.json
COPY libs/sdk-web/package.json libs/sdk-web/package.json

# --- Layer 2: Prisma schema and config (the anti-fraud postinstall runs `prisma generate`) ---
COPY apps/anti-fraud/prisma apps/anti-fraud/prisma
COPY apps/anti-fraud/prisma.config.ts apps/anti-fraud/prisma.config.ts

# --- Layer 3: install deps ---
ENV YARN_ENABLE_GLOBAL_CACHE=false
RUN yarn install --immutable

# --- Layer 4: shared tool configs (tsconfig bases), then the fraud lib source + build ---
COPY configs configs
COPY libs/fraud libs/fraud
RUN yarn workspace @iris-gate/fraud build

# --- Layer 5: copy remaining anti-fraud source ---
COPY apps/anti-fraud apps/anti-fraud
WORKDIR /repo/apps/anti-fraud

EXPOSE 3001

# Dev watch mode. `yarn run dev` rebuilds libs/fraud and regenerates the Prisma
# client first, because Compose mounts the host src/ over the image's copy.
CMD ["yarn", "run", "dev"]
