{
  "name": "@iris-gate/anti-fraud",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "yarn workspace @iris-gate/fraud build && prisma generate && bash -c 'set -a && [ -f .env ] && . ./.env; set +a && nest start --watch'",
    "build": "yarn workspace @iris-gate/fraud build && prisma generate && nest build",
    "start": "bash -c 'set -a && [ -f .env ] && . ./.env; set +a && node dist/main.js'",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "yarn workspace @iris-gate/fraud build && prisma generate && tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@iris-gate/fraud": "workspace:*",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/microservices": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "kafkajs": "2.2.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.2",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@iris-gate/fraud$": "<rootDir>/../../../libs/fraud/src",
      "^@iris-gate/fraud/(.*)$": "<rootDir>/../../../libs/fraud/src/$1"
    }
  }
}
