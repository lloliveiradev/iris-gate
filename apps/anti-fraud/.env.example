# apps/anti-fraud — local dev environment

# Postgres (mesma instância de infra/docker, banco separado pra evitar
# colisão com migrations do apps/api). Criar uma vez:
#   docker compose -f infra/docker/docker-compose.yml exec postgres \
#     psql -U iris -d iris -c "CREATE DATABASE antifraud OWNER iris;"
DATABASE_URL=postgresql://iris:iris@localhost:5432/antifraud?schema=public

# Kafka (mesmo broker do payments)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=anti-fraud
KAFKA_GROUP_ID=anti-fraud

# HTTP
PORT=3001

# Silence kafkajs default-partitioner warning (cosmetic)
KAFKAJS_NO_PARTITIONER_WARNING=1
