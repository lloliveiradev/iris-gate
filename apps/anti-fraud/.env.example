# apps/anti-fraud — local dev environment
#
# yarn dev loads this file when it sits next to the app as `.env`.
# Values below match the defaults in src/config/kafka.config.ts.
# Inside Compose the broker is kafka:9092, not localhost.
#
#   cp apps/anti-fraud/.env.example apps/anti-fraud/.env
#
# Create the database once, then apply migrations:
#   docker compose -f infra/docker/docker-compose.yml exec postgres \
#     psql -U iris -d iris -c "CREATE DATABASE antifraud OWNER iris;"
#   make -C apps/anti-fraud prisma-deploy

# Separate database from apps/api (that one uses `iris`).
DATABASE_URL=postgresql://iris:iris@localhost:5432/antifraud?schema=public

# HTTP
PORT=3001

# Kafka. Host process uses localhost; do not copy kafka:9092 here.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=iris-anti-fraud
KAFKA_CONSUMER_GROUP=iris-anti-fraud

# Topic names. The completed topic is also hardcoded in AssessRiskUseCase;
# keep the two values the same.
KAFKA_TOPIC_REQUEST=fraud.assessment.requested.v1
KAFKA_TOPIC_COMPLETED=fraud.assessment.completed.v1
KAFKA_TOPIC_DLQ=fraud.assessment.failed.dlq

# Outbox relay
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50

# Silence the kafkajs default-partitioner warning.
KAFKAJS_NO_PARTITIONER_WARNING=1
