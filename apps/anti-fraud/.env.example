# apps/anti-fraud — local dev environment
#
# yarn dev loads this file when it sits next to the app as `.env`.
# Values below match the defaults in src/config/kafka.config.ts.
# Inside Compose the broker is kafka:9092, not localhost.
#
#   cp apps/anti-fraud/.env.example apps/anti-fraud/.env
#
# The Postgres init scripts create the `antifraud` database and its roles;
# `make migrate` (repo root) applies the Prisma migrations.

# Separate database from apps/api (that one uses `iris`).
# Host port of Compose Postgres. Inside the network the hostname is postgres:5432.
# Passwords are the infra/docker/.env.example placeholders.
# Runtime role: DML only, no DDL.
DATABASE_URL=postgresql://antifraud_app:antifraud_app@localhost:15432/antifraud?schema=public
# Prisma CLI (prisma.config.ts): migrate deploy, db execute. Owns the schema.
ANTIFRAUD_MIGRATOR_DATABASE_URL=postgresql://antifraud_migrator:antifraud_migrator@localhost:15432/antifraud?schema=public
# Only for `prisma migrate dev`: an empty database owned by antifraud_migrator
# (see apps/anti-fraud/README.md). Leave unset otherwise.
# ANTIFRAUD_SHADOW_DATABASE_URL=postgresql://antifraud_migrator:antifraud_migrator@localhost:15432/antifraud_shadow?schema=public

# HTTP. Host process listens here. Compose sets PORT=3001 inside the container
# and publishes it on ANTI_FRAUD_PORT (13001).
PORT=13001

# Internal risk-scoring HTTP listener (POST /internal/v1/risk-assessments).
# Bound to 127.0.0.1 only; never exposed to browsers.
ANTI_FRAUD_INTERNAL_PORT=13002

# Bearer token required on POST /internal/v1/risk-assessments.
# Boot fails when unset or empty. Local placeholder only.
FRAUD_SERVICE_TOKEN=fraud_service_token

# Deterministic test scenarios (request.test_scenario = "blocked" | "review").
# Defaults to false in code; enabled here for local development and tests.
FRAUD_TEST_HOOKS=true

# Kafka. Host process uses the advertised host listener; do not copy kafka:9092 here.
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=iris-anti-fraud
KAFKA_CONSUMER_GROUP=iris-anti-fraud

# Topic names. The completed topic is also hardcoded in ScoreRiskUseCase
# (ASSESSMENT_COMPLETED_TOPIC); keep the two values the same.
KAFKA_TOPIC_COMPLETED=fraud.assessment.completed.v1

# Outbox relay
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50

# Silence the kafkajs default-partitioner warning.
KAFKAJS_NO_PARTITIONER_WARNING=1
