# apps/api — local dev environment
#
# config.Load reads the process environment only. It does not open this file.
# Export it before `make dev` when you need to override a default:
#
#   set -a && . apps/api/.env && set +a
#   make -C apps/api dev
#
# With no variables set, the defaults below are what the process already uses.
# Postgres and Kafka come from `make up`.

# Listen address.
HTTP_ADDR=:8080

# Same Postgres as Compose, on the host port (container port stays 5432).
# Database `iris` (anti-fraud uses `antifraud`). One URL per role; passwords
# are the infra/docker/.env.example placeholders.
# Request handlers and irisctl: DML only, no DDL.
IRIS_APP_DATABASE_URL=postgres://iris_app:iris_app@localhost:15432/iris?sslmode=disable
# Outbox relay (only read when RELAY_ENABLED=true).
IRIS_WORKER_DATABASE_URL=postgres://iris_worker:iris_worker@localhost:15432/iris?sslmode=disable
# cmd/migrate (`make migrate`) only. The API process never reads it.
IRIS_MIGRATOR_DATABASE_URL=postgres://iris_migrator:iris_migrator@localhost:15432/iris?sslmode=disable

# Comma-separated broker list. Host process uses the advertised host listener.
KAFKA_BROKER=localhost:19092

# Log field only.
ENV=dev

# Empty URL selects the in-memory fake acquirer.
# Set both to call an HTTP acquirer instead.
ACQUIRER_URL=
ACQUIRER_TOKEN=

# Poll the payments outbox and publish to Kafka.
RELAY_ENABLED=true

# Access-token signing keys (ADR-0006). Leave both empty to run without
# dashboard auth; set either one and config.Load requires a valid key set and
# an unexpired active kid, otherwise the process refuses to start. Nothing
# reads them yet.
#
# JWT_SIGNING_KEYS is a JSON array. private_key_b64 is a base64url raw 64-byte
# Ed25519 private key (or PKCS#8 DER); not_after (RFC 3339) is optional.
# Generate a LOCAL DEV key, never commit it and never reuse it elsewhere:
#
#   go run - <<'GO'
#   package main
#   import ("crypto/ed25519";"crypto/rand";"encoding/base64";"fmt")
#   func main(){_,k,_:=ed25519.GenerateKey(rand.Reader);fmt.Println(base64.RawURLEncoding.EncodeToString(k))}
#   GO
#
# Rotation: add the new key, switch JWT_ACTIVE_KID, then remove the old key at
# least 30 minutes later.
JWT_SIGNING_KEYS=
# kid of the key that signs new tokens; must exist in JWT_SIGNING_KEYS.
JWT_ACTIVE_KID=
