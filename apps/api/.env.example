# apps/api — local dev environment
#
# config.Load reads the process environment only. It does not open this file.
# Export it before `make dev` when you need to override a default:
#
#   set -a && . apps/api/.env && set +a
#   make -C apps/api dev
#
# With no variables set, the defaults below are what the process already uses.
# Postgres and Kafka come from `make up`.

# Listen address.
HTTP_ADDR=:8080

# Same Postgres as Compose, on the host port (container port stays 5432).
# Database `iris` (anti-fraud uses `antifraud`).
DATABASE_URL=postgres://iris:iris@localhost:15432/iris?sslmode=disable

# Comma-separated broker list. Host process uses the advertised host listener.
KAFKA_BROKER=localhost:19092

# Log field only.
ENV=dev

# Apply embedded identity and payments SQL on startup.
MIGRATE_ON_STARTUP=true

# Empty URL selects the in-memory fake acquirer.
# Set both to call an HTTP acquirer instead.
ACQUIRER_URL=
ACQUIRER_TOKEN=

# Poll the payments outbox and publish to Kafka.
RELAY_ENABLED=true
