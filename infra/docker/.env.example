# infra/docker — local Compose stack
#
# `make up` copies this file to `.env` when `.env` is missing.
# Unset values fall back to the same defaults inside docker-compose.yml.
# Host clients use localhost. Containers use service names (postgres, kafka).
#
# Host ports are off the well-known defaults on purpose. Another stack on
# this machine may already own 5432, 9092, 8081, or 3001. Container ports
# stay 5432, 9092, 8081, and 3001. An existing `.env` is not overwritten:
# update it, or delete it and run `make up` again, to pick up these values.

# Postgres bootstrap superuser and the `iris` database (apps/api). Only the
# init scripts and `make psql` use this role; no service connects with it.
POSTGRES_USER=iris
POSTGRES_PASSWORD=iris
POSTGRES_DB=iris
POSTGRES_PORT=15432

# Least-privilege roles, created by postgres/initdb/10-roles.sh (to-be section
# 9.2). The script reads these once, when the Postgres volume is empty: after a
# change, run `make nuke && make up`, then export the matching *_DATABASE_URL
# for apps/api and apps/anti-fraud (their defaults use the values below).
# Local placeholders only. Use URL-safe characters: the services put them in
# connection URLs.
IRIS_MIGRATOR_PASSWORD=iris_migrator
IRIS_APP_PASSWORD=iris_app
IRIS_WORKER_PASSWORD=iris_worker
IRIS_PLATFORM_PASSWORD=iris_platform
ANTIFRAUD_MIGRATOR_PASSWORD=antifraud_migrator
ANTIFRAUD_APP_PASSWORD=antifraud_app

# Host port of the PLAINTEXT_HOST listener. Advertised as localhost:${KAFKA_PORT}.
# Do not change KAFKA_CLUSTER_ID after the ig-kafka-data volume exists.
KAFKA_PORT=19092
KAFKA_CLUSTER_ID=iris-local-cluster-0001

# Schema registry (Karapace).
KARAPACE_PORT=18081

# Anti-fraud worker. The init scripts create its database and roles; `make
# migrate` applies the Prisma migrations as antifraud_migrator.
# The host port is 13001. Inside the container the process still listens on 3001.
ANTI_FRAUD_PORT=13001
ANTI_FRAUD_DB=antifraud
