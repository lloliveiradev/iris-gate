# infra/docker — local Compose stack
#
# `make up` copies this file to `.env` when `.env` is missing.
# Unset values fall back to the same defaults inside docker-compose.yml.
# Host clients use localhost. Containers use service names (postgres, kafka).
#
# Host ports are off the well-known defaults on purpose. Another stack on
# this machine may already own 5432, 9092, 8081, or 3001. Container ports
# stay 5432, 9092, 8081, and 3001. An existing `.env` is not overwritten:
# update it, or delete it and run `make up` again, to pick up these values.

# Postgres role and the `iris` database (apps/api).
POSTGRES_USER=iris
POSTGRES_PASSWORD=iris
POSTGRES_DB=iris
POSTGRES_PORT=15432

# Host port of the PLAINTEXT_HOST listener. Advertised as localhost:${KAFKA_PORT}.
# Do not change KAFKA_CLUSTER_ID after the ig-kafka-data volume exists.
KAFKA_PORT=19092
KAFKA_CLUSTER_ID=iris-local-cluster-0001

# Schema registry (Karapace).
KARAPACE_PORT=18081

# Anti-fraud worker. The database is not created by the Postgres image.
# After the first `make up`, create it and apply Prisma migrations:
#   make psql
#   CREATE DATABASE antifraud OWNER iris;
#   make -C apps/anti-fraud prisma-deploy
# The host port is 13001. Inside the container the process still listens on 3001.
ANTI_FRAUD_PORT=13001
ANTI_FRAUD_DB=antifraud
