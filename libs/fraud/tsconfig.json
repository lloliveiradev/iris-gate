{
  "extends": "../../configs/typescript/tsconfig.node.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["jest"],
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "declaration": true,
    "resolveJsonModule": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
