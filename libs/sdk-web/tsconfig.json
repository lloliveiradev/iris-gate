{
  "extends": "../../configs/typescript/tsconfig.bundler.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "verbatimModuleSyntax": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
