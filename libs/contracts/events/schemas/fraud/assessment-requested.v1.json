{
  "$id": "https://iris-gate/events/fraud/assessment-requested.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FraudAssessmentRequested (v1)",
  "description": "Emitido quando Payments precisa de uma decisão de risco para um PaymentIntent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "occurred_at",
    "assessment_id",
    "payment_intent_id",
    "merchant_id",
    "account_ref",
    "amount_cents",
    "currency"
  ],
  "properties": {
    "event_id":          { "type": "string", "format": "uuid" },
    "occurred_at":       { "type": "string", "format": "date-time" },
    "assessment_id":     { "type": "string", "format": "uuid" },
    "payment_intent_id": { "type": "string", "format": "uuid" },
    "merchant_id":       { "type": "string", "format": "uuid" },
    "account_ref":       { "type": "string", "minLength": 1, "maxLength": 128 },
    "amount_cents":      { "type": "integer", "minimum": 1 },
    "currency":          { "type": "string", "pattern": "^[A-Z]{3}$" }
  }
}
